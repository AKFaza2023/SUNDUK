<Window x:Class="Sunduk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SUNDUK 0.3"
        Width="1320"
        Height="820"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Background="{DynamicResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="86"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20,20,16,10">
                    <TextBlock Text="SUNDUK"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Всё важное — в одном месте"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,10">
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Главная" Click="NavButton_Click">⌂  Главная</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Каталог" Click="NavButton_Click">▦  Каталог</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Объявления" Click="NavButton_Click">◫  Объявления</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Закладки" Click="NavButton_Click">★  Закладки</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Контакты" Click="NavButton_Click">●  Контакты</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Заметки" Click="NavButton_Click">✎  Заметки</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Ежедневник" Click="NavButton_Click">▣  Ежедневник</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Задачи" Click="NavButton_Click">✓  Задачи</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Напоминания" Click="NavButton_Click">◷  Напоминания</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Файлы" Click="NavButton_Click">▤  Файлы</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Избранное" Click="NavButton_Click">♥  Избранное</Button>
                        <Separator Margin="16,8" Background="{DynamicResource BorderBrush}"/>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Настройки" Click="NavButton_Click">⚙  Настройки</Button>
                        <Button Style="{StaticResource NavButtonStyle}" Tag="Поддержка" Click="NavButton_Click">?  Поддержка</Button>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="20,8,16,16">
                    <TextBlock Text="Разработка СтавДок"
                               FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Margin="0,4,0,0">
                        <Hyperlink NavigateUri="https://xn--80aegytoh.xn--p1ai"
                                   RequestNavigate="DeveloperSite_RequestNavigate">
                            ставдок.рф
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text="Версия 0.3.0"
                               FontSize="11"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   Text="Главная"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitle"
                                   Text="Рабочее пространство SUNDUK"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Тёмная"
                                Click="DarkTheme_Click">☾</Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Светлая"
                                Click="LightTheme_Click">☀</Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="Как в системе"
                                Click="SystemTheme_Click">▣</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24">

                <ScrollViewer x:Name="DashboardView"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="24"
                                Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Добро пожаловать в SUNDUK"
                                               FontSize="28"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Каталог, контакты, заметки и важные данные хранятся локально на вашем компьютере."
                                               Margin="0,8,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Margin="20,2,0,2"
                                        Click="AddCard_Click">+ Новая карточка</Button>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel><TextBlock Text="Товары" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ProductsCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel><TextBlock Text="Контакты" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ContactsCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel><TextBlock Text="Заметки" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="NotesCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <Border Grid.Column="6" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel><TextBlock Text="Закладки" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="BookmarksCountText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Последние записи" FontSize="18" FontWeight="SemiBold"/>
                                    <ListView x:Name="LatestList" Margin="0,12,0,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" Height="270">
                                        <ListView.View><GridView><GridViewColumn Header="Тип" Width="110" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="Название" Width="260" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="Категория" Width="160" DisplayMemberBinding="{Binding Category}"/></GridView></ListView.View>
                                    </ListView>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Быстрые действия" FontSize="18" FontWeight="SemiBold"/>
                                    <Button Style="{StaticResource AccentButtonStyle}" Margin="0,14,0,8" Tag="Контакт|Новый контакт|Контакты" Click="QuickAdd_Click">+ Добавить контакт</Button>
                                    <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,0,8" Tag="Заметка|Новая заметка|Заметки" Click="QuickAdd_Click">+ Добавить заметку</Button>
                                    <Button Style="{StaticResource AccentButtonStyle}" Margin="0,0,0,8" Tag="Закладка|Новая закладка|Ссылки" Click="QuickAdd_Click">+ Добавить закладку</Button>
                                    <TextBlock Text="База данных:" Margin="0,16,0,0" Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="%LOCALAPPDATA%\SUNDUK\Data\sunduk.db" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="CatalogView" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Height="38" Padding="12,8" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" TextChanged="SearchBox_TextChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0" Click="AddCard_Click">+ Новая карточка</Button>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                        <ListView x:Name="CatalogList" Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0">
                            <ListView.View><GridView><GridViewColumn Header="ID" Width="70" DisplayMemberBinding="{Binding Id}"/><GridViewColumn Header="Тип" Width="120" DisplayMemberBinding="{Binding Kind}"/><GridViewColumn Header="Название" Width="300" DisplayMemberBinding="{Binding Title}"/><GridViewColumn Header="Категория" Width="180" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="Описание" Width="360" DisplayMemberBinding="{Binding Note}"/></GridView></ListView.View>
                        </ListView>
                    </Border>
                </Grid>

                <Border x:Name="PlaceholderView" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="28">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTitle" Text="Раздел" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PlaceholderText" Text="Раздел подготовлен в навигации и будет развиваться по дорожной карте SUNDUK." FontSize="14" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="24,0"><TextBlock x:Name="StatusText" Text="Готово" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
