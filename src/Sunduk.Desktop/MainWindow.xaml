<Window x:Class="Sunduk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SUNDUK"
        Width="1536" Height="864" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#00162E" Foreground="#132238"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="TopIconButton" TargetType="Button">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F5F8FC"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="21"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="46"/><Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="14,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F5F8FC"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#102C4E"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#2385EA"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Height" Value="44"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#E4E9EF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#F7FAFC"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SmallCheck" TargetType="CheckBox"><Setter Property="Margin" Value="0,4"/><Setter Property="FontSize" Value="11"/></Style>
    </Window.Resources>

    <Grid Background="#00162E">
        <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <!-- Brand -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="16,0,8,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="35" Height="35" VerticalAlignment="Center">
                <Polygon Points="17.5,1 33,10 33,27 17.5,36 2,27 2,10" Stroke="#F4F8FD" StrokeThickness="2" Fill="Transparent"/>
                <Polygon Points="17.5,7 27.5,13 27.5,24 17.5,30 7.5,24 7.5,13" Stroke="#F4F8FD" StrokeThickness="1.4" Fill="Transparent"/>
            </Grid>
            <TextBlock Grid.Column="1" Text="SUNDUK" Foreground="White" FontWeight="SemiBold" FontSize="24" VerticalAlignment="Center" Margin="3,0,0,0"/>
        </Grid>

        <!-- Dark top bar -->
        <Grid Grid.Row="0" Grid.Column="1" Background="#00162E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="20,9,16,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#071E38" BorderBrush="#2A4667" BorderThickness="1" CornerRadius="8" Height="42" MaxWidth="715" HorizontalAlignment="Stretch">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" Foreground="#F0F5FB" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="TopSearchBox" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center" FontSize="13" Padding="2,0" ToolTip="Поиск по каталогу" KeyDown="TopSearchBox_KeyDown"/>
                        <TextBlock Grid.Column="1" Text="Поиск по каталогу..." Foreground="#AEBCCD" VerticalAlignment="Center" FontSize="12.5" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=TopSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Grid Grid.Column="2" Height="42">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <Button Click="AddCard_Click" Background="#0BAA39" Foreground="White" BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Content="＋  Создать"/>
                    <Button Grid.Column="1" Background="#07942F" Foreground="White" BorderThickness="0" FontSize="15" Cursor="Hand" Content="⌄"/>
                </Grid>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource TopIconButton}" ToolTip="Уведомления" Content="♧"/>
                    <Button Style="{StaticResource TopIconButton}" ToolTip="Календарь" Content="▣" Tag="Ежедневник" Click="NavButton_Click"/>
                    <Button Style="{StaticResource TopIconButton}" ToolTip="Тема" Content="☾" Click="DarkTheme_Click"/>
                    <Button Style="{StaticResource TopIconButton}" ToolTip="Справка" Content="?" Tag="Поддержка" Click="NavButton_Click"/>
                    <Button Style="{StaticResource TopIconButton}" ToolTip="Свернуть" Content="−" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TopIconButton}" ToolTip="Развернуть" Content="□" Click="Maximize_Click"/>
                    <Button Style="{StaticResource TopIconButton}" ToolTip="Закрыть" Content="×" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Sidebar -->
        <Grid Grid.Row="1" Grid.Column="0" Background="#00162E">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <Button Style="{StaticResource MenuButton}" Tag="Главная" Click="NavButton_Click" Background="#102C4E">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="4" Background="#06C846" CornerRadius="2" Margin="-14,0,0,0" HorizontalAlignment="Left"/><TextBlock Grid.Column="0" Text="⌂" FontSize="22"/><TextBlock Grid.Column="1" Text="Главная" Margin="6,0,0,0" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Каталог" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▦" FontSize="20"/><TextBlock Grid.Column="1" Text="Каталог" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="128" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Объявления" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="◉" FontSize="20"/><TextBlock Grid.Column="1" Text="Объявления" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="37" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Закладки" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="♧" FontSize="20"/><TextBlock Grid.Column="1" Text="Закладки" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="54" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Контакты" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="♙" FontSize="20"/><TextBlock Grid.Column="1" Text="Контакты" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="86" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Заметки" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▣" FontSize="19"/><TextBlock Grid.Column="1" Text="Заметки" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="23" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Ежедневник" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="▦" FontSize="19"/><TextBlock Grid.Column="1" Text="Ежедневник" Margin="6,0,0,0"/></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Задачи" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="✓" FontSize="20"/><TextBlock Grid.Column="1" Text="Задачи" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="12" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Напоминания" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="♧" FontSize="19"/><TextBlock Grid.Column="1" Text="Напоминания" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="8" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Файлы" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▤" FontSize="19"/><TextBlock Grid.Column="1" Text="Файлы" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="91" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Избранное" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="☆" FontSize="21"/><TextBlock Grid.Column="1" Text="Избранное" Margin="6,0,0,0"/><Border Grid.Column="2" Background="#173656" CornerRadius="7" Padding="7,3"><TextBlock Text="16" FontSize="11"/></Border></Grid></Button>
                    <Button Style="{StaticResource MenuButton}" Tag="Настройки" Click="NavButton_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⚙" FontSize="19"/><TextBlock Grid.Column="1" Text="Настройки" Margin="6,0,0,0"/></Grid></Button>
                    <Border Margin="16,70,16,10" Height="64" CornerRadius="8" BorderBrush="#24435F" BorderThickness="1" Background="#071E38">
                        <Button Tag="Поддержка" Click="NavButton_Click" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="15" Cursor="Hand"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="♧" FontSize="26" Margin="0,0,12,0"/><TextBlock Text="Поддержка" VerticalAlignment="Center"/></StackPanel></Button>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,0,17" VerticalAlignment="Bottom"><Ellipse Width="11" Height="11" Fill="#10C742"/><TextBlock Text="База данных: локальная" Foreground="#D2DCE8" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
        </Grid>

        <!-- Main white rounded workspace -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="2,0,2,0">
            <Border x:Name="DashboardView" Background="#FFFFFF" CornerRadius="13" Padding="20,15,20,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="82"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="PageTitle" Text="Главная" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Обзор ваших данных и быстрый доступ к важному" FontSize="12" Foreground="#506176" Margin="0,3,0,0"/></StackPanel>

                    <!-- six summary cards -->
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#EAF8EF"><TextBlock Text="A" Foreground="#12A947" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Карточки" FontSize="10"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="ProductsCountText" Text="128" FontSize="20" FontWeight="Bold"/><TextBlock Text="  ↑ 12" Foreground="#11A947" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock Text="всего" Foreground="#6E7C8D" FontSize="9.5"/></StackPanel></Grid></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#EDF5FF"><TextBlock Text="●" Foreground="#1689FF" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Контакты" FontSize="10"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="ContactsCountText" Text="86" FontSize="20" FontWeight="Bold"/><TextBlock Text="  ↑ 5" Foreground="#11A947" FontSize="11" VerticalAlignment="Center"/></StackPanel><TextBlock Text="всего" Foreground="#6E7C8D" FontSize="9.5"/></StackPanel></Grid></Border>
                        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#F4EEFF"><TextBlock Text="✓" Foreground="#7B2BE2" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Задачи" FontSize="10"/><TextBlock Text="12" FontSize="20" FontWeight="Bold"/><TextBlock Text="4 просрочено" Foreground="#F44336" FontSize="9.5"/></StackPanel></Grid></Border>
                        <Border Grid.Column="6" Style="{StaticResource Card}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#FFF5EA"><TextBlock Text="♟" Foreground="#FF8A00" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Напоминания" FontSize="10"/><TextBlock Text="8" FontSize="20" FontWeight="Bold"/><TextBlock Text="3 сегодня" Foreground="#2385EA" FontSize="9.5"/></StackPanel></Grid></Border>
                        <Border Grid.Column="8" Style="{StaticResource Card}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#EEF6FF"><TextBlock Text="■" Foreground="#1689FF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Файлы" FontSize="10"/><TextBlock Text="91" FontSize="20" FontWeight="Bold"/><TextBlock Text="↑ 7 новых" Foreground="#11A947" FontSize="9.5"/></StackPanel></Grid></Border>
                        <Border Grid.Column="10" Style="{StaticResource Card}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="9" Background="#EAF8EF"><TextBlock Text="◀" Foreground="#10A644" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="Объявления" FontSize="10"/><TextBlock Text="37" FontSize="20" FontWeight="Bold"/><TextBlock Text="↑ 3 активных" Foreground="#11A947" FontSize="9.5"/></StackPanel></Grid></Border>
                    </Grid>

                    <!-- dashboard grid -->
                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.18*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.13*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>
                        <!-- col 1 -->
                        <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="226"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="13"><StackPanel><TextBlock Text="Быстрые действия" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                <Button Style="{StaticResource QuickButton}" Click="AddCard_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Width="29" Height="29" Background="#EAF8EF" CornerRadius="7"><TextBlock Text="A" Foreground="#11A947" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Новая карточка" VerticalAlignment="Center" FontSize="11"/><TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="#7C8B9B"/></Grid></Button>
                                <Button Style="{StaticResource QuickButton}" Tag="Объявление|Новое объявление|Объявления" Click="QuickAdd_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Width="29" Height="29" Background="#EAF8EF" CornerRadius="7"><TextBlock Text="◀" Foreground="#11A947" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Новое объявление" VerticalAlignment="Center" FontSize="11"/><TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="#7C8B9B"/></Grid></Button>
                                <Button Style="{StaticResource QuickButton}" Tag="Заметка|Новая заметка|Заметки" Click="QuickAdd_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Width="29" Height="29" Background="#FFF5DF" CornerRadius="7"><TextBlock Text="▣" Foreground="#FFAA00" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Новая заметка" VerticalAlignment="Center" FontSize="11"/><TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="#7C8B9B"/></Grid></Button>
                                <Button Style="{StaticResource QuickButton}" Tag="Контакт|Новый контакт|Контакты" Click="QuickAdd_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Width="29" Height="29" Background="#EDF5FF" CornerRadius="7"><TextBlock Text="●" Foreground="#1689FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="Новый контакт" VerticalAlignment="Center" FontSize="11"/><TextBlock Grid.Column="2" Text="›" FontSize="20" Foreground="#7C8B9B"/></Grid></Button>
                            </StackPanel></Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Избранное" FontSize="14" FontWeight="SemiBold"/><Border Grid.Column="1" Background="#F2F5F8" CornerRadius="7" Padding="7,2"><TextBlock Text="16" FontSize="10"/></Border></Grid>
                                <TextBlock Text="A   ООО «АльфаПоставка»                                      ★" FontSize="11" Margin="0,15,0,0"/><TextBlock Text="      Поставка масла" Foreground="#728195" FontSize="9.5"/>
                                <TextBlock Text="●   Петров Андрей Сергеевич                               ★" FontSize="11" Margin="0,13,0,0"/><TextBlock Text="      Клиент" Foreground="#728195" FontSize="9.5"/>
                                <TextBlock Text="◀   Поставка воротных оборудования                  ★" FontSize="11" Margin="0,13,0,0"/><TextBlock Text="      Обсуждение" Foreground="#728195" FontSize="9.5"/>
                                <TextBlock Text="■   Коммерческое предложение №15                      ★" FontSize="11" Margin="0,13,0,0"/><TextBlock Text="      Файл • PDF" Foreground="#728195" FontSize="9.5"/>
                            </StackPanel></Border>
                        </Grid>

                        <!-- col 2 -->
                        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="294"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="13"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="▣   Сегодня" FontSize="14" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="25.06.2026" Foreground="#7A899A" FontSize="9.5"/></Grid>
                                <TextBlock Text="Задачи                                 2 из 6" FontWeight="SemiBold" FontSize="10.5" Margin="0,18,0,4"/>
                                <CheckBox Style="{StaticResource SmallCheck}" Content="Подготовить КП для ООО «СтройМакс»"/><CheckBox Style="{StaticResource SmallCheck}" Content="Согласовать условия поставки"/><CheckBox Style="{StaticResource SmallCheck}" Content="Позвонить клиенту: ИП Иванов Д.В."/>
                                <Button Style="{StaticResource LinkButton}" Content="Показать все" HorizontalAlignment="Left" Margin="17,2,0,0"/>
                                <TextBlock Text="♧   Напоминания" FontWeight="SemiBold" FontSize="10.5" Margin="0,13,0,4"/>
                                <CheckBox Style="{StaticResource SmallCheck}" Content="Встреча с поставщиком оборудования"/><CheckBox Style="{StaticResource SmallCheck}" Content="Оплатить счёт по поставке №2045"/>
                                <Button Style="{StaticResource LinkButton}" Content="Показать все" HorizontalAlignment="Left" Margin="17,2,0,0"/>
                            </StackPanel></Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions><TextBlock Text="Последние элементы" FontSize="14" FontWeight="SemiBold"/>
                                <ListView x:Name="LatestList" Grid.Row="1" BorderThickness="0" Background="Transparent" FontSize="10" Margin="0,4,0,0"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="A" Foreground="#11A947" FontWeight="Bold" FontSize="17"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="#7A899A" FontSize="9"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="#2385EA" FontSize="9" VerticalAlignment="Center"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
                                <Button Grid.Row="2" Style="{StaticResource LinkButton}" Content="Показать все элементы" HorizontalAlignment="Center"/>
                            </Grid></Border>
                        </Grid>

                        <!-- col 3 -->
                        <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="294"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="13"><StackPanel><TextBlock Text="◷   Недавние изменения" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="A   Обновлена карточка" Foreground="#11A947" FontSize="11" Margin="0,18,0,0"/><TextBlock Text="      ООО «АльфаПоставка»                         2 мин назад" FontSize="9.5"/>
